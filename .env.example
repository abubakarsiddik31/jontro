# Copy to .env and fill in what you need. .env is gitignored.

# Only needed to regenerate the corpus or to run the retention judge (Gemini API).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed to score a model through an OpenAI-compatible endpoint
# (scripts/run_multiturn_baselines.py without --oracle).
EVAL_API_KEY=
EVAL_BASE_URL=

# Only needed to upload adapters or datasets to Hugging Face.
HF_TOKEN=
